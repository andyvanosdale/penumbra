# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/
.pytest_cache/

# Data: raw snapshots are immutable artifacts, kept out of git by default.
# Track them with DVC/git-lfs or an external store; never re-pull silently.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.duckdb
*.sqlite
*.db
*.sqlite-journal

